# ==============================================================================
# KijaniAI Geospatial Intelligence Platform Environment Configuration
# ==============================================================================

# Core Application & Security
SECRET_KEY=kijani-secret-key-production-change-in-env-928472918
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PUBLIC_VERIFY_URL=https://kijani.ai/verify

# ------------------------------------------------------------------------------
# DOCKER COMPOSE SERVICE CREDENTIALS & HOST PORTS
# Single source of truth: docker-compose.yml interpolates these ${VARS} directly.
# Non-default ports/passwords are used so KijaniAI never collides with other
# local dev stacks that squat the well-known defaults (5432, 6379, 8000, etc).
# ------------------------------------------------------------------------------
POSTGRES_USER=kijani
POSTGRES_PASSWORD=KijaniPgSecure2026
POSTGRES_DB=kijani_db
POSTGRES_PORT=5442

REDIS_PASSWORD=KijaniRedisSecure2026
REDIS_PORT=6783

MINIO_ROOT_USER=kijanistorageadmin
MINIO_ROOT_PASSWORD=KijaniMinioSecure2026
MINIO_API_PORT=9012
MINIO_CONSOLE_PORT=9013

OLLAMA_PORT=11444

API_PORT=8012
FRONTEND_PORT=3012

# Spatial Database (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL=postgresql://kijani:KijaniPgSecure2026@localhost:5442/kijani_db

# Redis Message Broker & Celery
REDIS_URL=redis://:KijaniRedisSecure2026@localhost:6783/0
CELERY_BROKER_URL=redis://:KijaniRedisSecure2026@localhost:6783/0
CELERY_RESULT_BACKEND=redis://:KijaniRedisSecure2026@localhost:6783/0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9012
STORAGE_ACCESS_KEY=kijanistorageadmin
STORAGE_SECRET_KEY=KijaniMinioSecure2026

# Ollama Local LLM (Gemma 4 Bilingual Copilot)
OLLAMA_BASE_URL=http://localhost:11444
OLLAMA_MODEL=llama3.3

# ==============================================================================
# SATELLITE PROVIDER APIS & DATASET INGESTION (TIERS 1 - 4)
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 1: PUBLIC / FREE (10m - 30m)
# Sensors: Sentinel-2 MSI Optical, Sentinel-1 C-SAR, Landsat 8/9 OLI/TIRS, CHIRPS Daily Rainfall
# Free-Tier Provider Choice: GEE (Google Earth Engine), PLANETARY_COMPUTER, or CDSE
# In GEE, planetary reductions (NDVI, NDWI, SAR, CHIRPS) run server-side before DB conversion.
# ------------------------------------------------------------------------------
FREE_TIER_PROVIDER=GEE

# Google Earth Engine (GEE) Planetary Compute Engine
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_JSON=

# CHIRPS Satellite Rainfall Dataset (UCSB Climate Hazards Center, 0.05° resolution)
CHIRPS_DATASET_ID=UCSB-CHG/CHIRPS/DAILY

# OpenWeatherMap API (72h Forecast Gating, Micro-Meteorology & FAO-56 Penman-Monteith Forecasts)
# Obtain a free API key at https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHERMAP_GEOCODING_URL=https://api.openweathermap.org/geo/1.0
OPENWEATHERMAP_UNITS=metric

# Microsoft Planetary Computer STAC API (Alternative Free-Tier Provider)
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PLANETARY_COMPUTER_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1/token
PLANETARY_COMPUTER_API_KEY=

# Copernicus Data Space Ecosystem (CDSE) API (Alternative Free-Tier Provider)
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# TIER 2: MEDIUM RESOLUTION (3m - 5m)
# Sensors: PlanetScope SuperDove (8-band VNIR)
# Capabilities: Daily high-cadence monitoring, automated parcel polygon clipping
# Powers: Field-scale dynamic crop coefficients (Kc) and in-season moisture stress
# ------------------------------------------------------------------------------
PLANET_DATA_API_URL=https://api.planet.com/data/v1
PLANET_ORDERS_API_URL=https://api.planet.com/compute/ops/orders/v2
PLANET_API_KEY=

# ------------------------------------------------------------------------------
# TIER 3: VERY HIGH RESOLUTION (50cm VHR)
# Sensors: SkySat, Pléiades 1A/1B, SPOT 6/7
# Capabilities: Commercial catalog querying, automated quotation, tasking/delivery
# Powers: Individual tree crown counting, canopy structural analysis
# ------------------------------------------------------------------------------
# UP42 Geospatial Platform API v2
UP42_API_URL=https://api.up42.com/v2
UP42_OAUTH_URL=https://api.up42.com/oauth/token
UP42_PROJECT_ID=
UP42_API_KEY=

# Airbus OneAtlas Living Library & Ordering API
AIRBUS_ONEATLAS_API_URL=https://api.oneatlas.airbus.com/api/v1
AIRBUS_ONEATLAS_TOKEN_URL=https://api.oneatlas.airbus.com/api/v1/token
AIRBUS_API_KEY=

# ------------------------------------------------------------------------------
# TIER 4: ULTRA VHR (30cm VHR)
# Sensors: WorldView-3, WorldView-4, Pléiades Neo
# Capabilities: Sub-meter canopy segmentation, precision tree crown detection
# ------------------------------------------------------------------------------
# Maxar Discovery & Ordering API
MAXAR_DISCOVERY_API_URL=https://api.maxar.com/discovery/v1
MAXAR_TOKEN_URL=https://api.maxar.com/token
MAXAR_API_KEY=

# UP42 Pléiades Neo 30cm Tasking & Catalog API
PLEIADES_NEO_API_URL=https://api.up42.com/v2/catalog/hosts/oneatlas
PLEIADES_NEO_API_KEY=

# ==============================================================================
# EMAIL NOTIFICATION (SMTP via Gmail Relay - suanet.ac.tz)
# Used for: MabadilikoAI job completion, imagery order alerts, and MRV certificates
# ==============================================================================
SMTP_PROTOCOL=smtp
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@suanet.ac.tz
SMTP_PASSWORD=szkl khpt zglb evta
SMTP_CRYPTO=tls
SMTP_FROM_EMAIL=noreply@suanet.ac.tz
SMTP_FROM_NAME=KijaniAI Platform
SMTP_MAILTYPE=html
SMTP_CHARSET=utf8

# ------------------------------------------------------------------------------
# SYSTEM OPERATIONAL MODE
# "TESTING" = High-fidelity calibrated boundary-constrained simulation (convincing for donors/investors without GPU/quota costs)
# "PRODUCTION" = Real operational models (DeepForest PyTorch RetinaNet, live GEE reductions, real STAC downloads)
# ------------------------------------------------------------------------------
SYSTEM_MODE=TESTING
DEEPFOREST_MODEL_PATH=
DEEPFOREST_CONFIDENCE_THRESHOLD=0.25

# ------------------------------------------------------------------------------
# OFFICIAL TANZANIA ADMINISTRATIVE BOUNDARIES (NBS 2022 CENSUS WARDS)
# Source: National Bureau of Statistics (NBS) Tanzania / Sensa 2022
# ------------------------------------------------------------------------------
TANZANIA_NBS_WARD_SHAPEFILES_URL=https://www.nbs.go.tz/uploads/statistics/documents/en-1714652282-TANZANIA_2022PHC_WARD_SHAPEFILES.zip
TANZANIA_SHAPEFILES_DIR=backend/data/shapefiles/tanzania_2022_wards
